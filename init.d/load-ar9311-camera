#!/bin/sh
# Load the AR9311 (BetaFPV P1) camera chain and the wave5 codec.
#
# The MissingLynk open camera stack: sensor -> CSI-2 receiver -> VIF -> ISP
# -> CVISP, which exposes the "ar-cvisp" V4L2 capture node waybeam reads.
# Sink before source is not required at load time; streaming order is
# handled by the drivers at STREAMON.
#
# The P1 is fitted with an NT99235 or an SC231AI.  One device tree node
# names both; each driver reads the chip ID at probe and only the fitted
# sensor's driver binds, so the sensors are tried in turn and the ISP gets
# the bound one's tuning file and white balance.
#
# Load once per boot and never unload: wave5 uploads its firmware at probe
# and cannot be re-probed without a power cycle (a second probe returns
# -EBUSY and leaves the codec unbound).
#
# NT99235_EXPOSURE (lines, driver default 1123) and NT99235_GAIN set the
# NT99235's starting point; waybeam's AE takes over from there.

SENSORS="nt99235 sc231ai"
MODULES="ar-csi2 ar-vif ar-isp ar-cvisp wave5"

# SC231AI white balance, Q8: neutral grey on a D65 monitor, measured on a
# P1 (the ISP leaves 1.0, which turns this sensor green).
SC231AI_WB_RED=461
SC231AI_WB_BLUE=743

loaded()
{
	lsmod | grep -q "^$(echo "$1" | tr - _) "
}

# Has the sensor's i2c driver bound a device ("0-001a" in its directory)?
bound()
{
	for d in /sys/bus/i2c/drivers/"$1"/[0-9]*-*; do
		[ -e "$d" ] && return 0
	done
	return 1
}

sensor_args()
{
	if [ "$1" = nt99235 ]; then
		[ -n "$NT99235_EXPOSURE" ] && printf ' exposure=%s' "$NT99235_EXPOSURE"
		[ -n "$NT99235_GAIN" ] && printf ' gain=%s' "$NT99235_GAIN"
	fi
}

# ar-isp and ar-cvisp take the bound sensor's tuning file; the NT99235's
# is the device tree's default.
isp_args()
{
	case "$1" in
	sc231ai)
		printf ' tuning=artosyn/sc231ai-tuning-preview-fpv.bin'
		[ "$2" = ar-isp ] &&
			printf ' wb_red=%s wb_blue=%s' "$SC231AI_WB_RED" "$SC231AI_WB_BLUE"
		;;
	esac
}

start()
{
	# waybeam resets the VPU through wave5's debugfs hook before each
	# encoder open (see docs/AR9311_BACKEND.md).
	grep -q " /sys/kernel/debug " /proc/mounts ||
		mount -t debugfs none /sys/kernel/debug
	sensor=""
	for s in $SENSORS; do
		# shellcheck disable=SC2046
		loaded "$s" || modprobe "$s" $(sensor_args "$s") ||
			{ echo "load-ar9311-camera: $s failed" >&2; return 1; }
		if bound "$s"; then
			sensor=$s
			break
		fi
	done
	if [ -z "$sensor" ]; then
		echo "load-ar9311-camera: no camera sensor answered ($SENSORS)" >&2
		return 1
	fi
	for m in $MODULES; do
		loaded "$m" && continue
		# shellcheck disable=SC2046
		modprobe "$m" $(isp_args "$sensor" "$m") ||
			{ echo "load-ar9311-camera: $m failed" >&2; return 1; }
	done
	for p in /sys/class/video4linux/video*; do
		[ "$(cat "$p/name" 2>/dev/null)" = ar-cvisp ] && return 0
	done
	echo "load-ar9311-camera: no ar-cvisp node after loading" >&2
	return 1
}

case "$1" in
start) start ;;
*) echo "usage: $0 start" >&2; exit 2 ;;
esac
